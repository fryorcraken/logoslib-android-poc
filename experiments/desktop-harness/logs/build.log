== slow-host wrapper (delays the child's exec for lez_probe / ev_probe only) ==
#!/usr/bin/env bash
case " $* " in
  *" --name lez_probe "*|*" --name ev_probe "*) sleep "${DH_SLOW_HOST_S:-3}" ;;
esac
exec /nix/store/7jcna50jgjmzx28nk6a14x5y6f5dwlrb-logos-liblogos/bin/logos_host "$@"
