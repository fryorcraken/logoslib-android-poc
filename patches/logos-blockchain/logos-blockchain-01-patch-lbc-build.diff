# rationale: point the workspace at the patched lbc-build copy (patches/logos-blockchain-circuits/circuits-02) via [patch]; upstream would instead bump the lbc tag. Placed before [workspace.lints.clippy], whose surrounding lines are identical at logos-blockchain 0.3.0-rc.4 (39916dc8, which reformatted Cargo.toml) and at the module pin 35a4a666, so it applies to both.
diff --git a/Cargo.toml b/Cargo.toml
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -310,2 +310,7 @@

+# Android: lbc-build hard-codes -lstdc++ on every non-macOS target; the patched copy
+# (v0.5.7 + one-line change) emits -lc++ (NDK linker script -> libc++_shared) for target_os=android.
+[patch."https://github.com/logos-blockchain/logos-blockchain-circuits.git"]
+logos-blockchain-circuits-build = { path = "../logos-blockchain-circuits/rust/logos-blockchain-circuits-build" }
+
 [workspace.lints.clippy]
