Rationale: non-breaking replacement for 01 - make logos-blockchain-common-http-client optional in lez/common behind feature bedrock-auth, enabled only by sequencer_core and indexer_core, so wallet-ffi's graph has no Bedrock crates.

diff --git a/lez/common/Cargo.toml b/lez/common/Cargo.toml
index 449ad59c2..b22ed324f 100644
--- a/lez/common/Cargo.toml
+++ b/lez/common/Cargo.toml
@@ -29,7 +29,12 @@ sha2.workspace = true
 log.workspace = true
 hex.workspace = true
 borsh.workspace = true
-logos-blockchain-common-http-client.workspace = true
+logos-blockchain-common-http-client = { workspace = true, optional = true }
+
+[features]
+# `From<BasicAuth> for BasicAuthCredentials`; pulls the Bedrock stack
+# (circuits, rapidsnark, GMP). Needed by sequencer/indexer, not by the wallet.
+bedrock-auth = ["dep:logos-blockchain-common-http-client"]
 
 [dev-dependencies]
 lee = { workspace = true, features = ["test-utils"] }
