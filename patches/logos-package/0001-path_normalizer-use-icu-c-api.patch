+// UTF-8 -> UTF-16 exactly like icu::UnicodeString::fromUTF8(): ill-formed
+// sequences become U+FFFD (u_strFromUTF8WithSub with 0xFFFD is what
+// UnicodeString::setToUTF8 calls). Returns false where fromUTF8 would have
+// produced a bogus string.
+bool utf8ToUtf16(const std::string& in, std::vector<UChar>& out) {
+    if (in.size() >= static_cast<size_t>(INT32_MAX)) {
+        return false;
+    }
+    // UTF-16 never needs more code units than UTF-8 has bytes; +1 leaves
+    // room for the terminating NUL ICU writes when it fits.
+    out.resize(in.size() + 1);
+    int32_t length16 = 0;
+    UErrorCode status = U_ZERO_ERROR;
+    u_strFromUTF8WithSub(out.data(), static_cast<int32_t>(out.size()), &length16,
+                         in.data(), static_cast<int32_t>(in.size()),
+                         0xFFFD, nullptr, &status);
+    if (U_FAILURE(status)) {
+        out.clear();
+        return false;
+    }
+    out.resize(static_cast<size_t>(length16));
+    return true;
+}
+
+// UTF-16 -> UTF-8 exactly like icu::UnicodeString::toUTF8String() (it calls
+// u_strToUTF8WithSub with 0xFFFD, so an unpaired surrogate becomes U+FFFD).
+bool utf16ToUtf8(const UChar* s, int32_t length16, std::string& out) {
+    out.clear();
+    if (length16 == 0) {
+        return true;
+    }
+    // Each UTF-16 code unit needs at most 3 UTF-8 bytes (a surrogate pair,
+    // 2 units, needs 4).
+    std::vector<char> buf(static_cast<size_t>(length16) * 3 + 1);
+    int32_t length8 = 0;
+    UErrorCode status = U_ZERO_ERROR;
+    u_strToUTF8WithSub(buf.data(), static_cast<int32_t>(buf.size()), &length8,
+                       s, length16, 0xFFFD, nullptr, &status);
+    if (U_FAILURE(status)) {
+        return false;
+    }
+    out.assign(buf.data(), static_cast<size_t>(length8));
+    return true;
+}
+
+// Run an ICU "preflighting" string function (dest, capacity, &status) ->
+// length: try once with a guess, and again with the exact size on
+// U_BUFFER_OVERFLOW_ERROR.
+template <typename Fn>
+bool runPreflighted(std::vector<UChar>& dest, int32_t& length, Fn&& fn) {
+    UErrorCode status = U_ZERO_ERROR;
+    length = fn(dest.data(), static_cast<int32_t>(dest.size()), &status);
+    if (status == U_BUFFER_OVERFLOW_ERROR) {
+        dest.resize(static_cast<size_t>(length) + 1);
+        status = U_ZERO_ERROR;
+        length = fn(dest.data(), static_cast<int32_t>(dest.size()), &status);
+    }
+    return U_SUCCESS(status);
+}
+
