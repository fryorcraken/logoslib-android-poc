+    // android-amd64). Other Android ABIs (armeabi-v7a, x86, riscv64) have no
+    // rule yet and fail closed.
+    #if defined(__aarch64__)
+        return "android-arm64";
+    #elif defined(__x86_64__)
+        return "android-x86_64";
+    #else
+        return "unknown";
+    #endif
 #elif defined(__linux__)
