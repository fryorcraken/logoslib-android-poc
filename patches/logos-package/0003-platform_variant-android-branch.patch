+#elif defined(__ANDROID__)
+    // Must precede __linux__: bionic defines __linux__ too, and without this
+    // branch an Android build answers linux-arm64 / linux-x86_64 and would
+    // select glibc payloads it cannot load. The architecture half keeps the
